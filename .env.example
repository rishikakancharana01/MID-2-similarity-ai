# Backend Configuration
PORT=8000
HOST=0.0.0.0
SIMILARITY_MODEL=all-MiniLM-L6-v2
MIN_RELEVANCE_THRESHOLD=0.25
MAX_UPLOAD_SIZE_MB=15

# Optional LLM API Key (if you wish to enable generative summary enhancement instead of pure extractive answers)
